#!/bin/sh
set -e

# Rust formatting check
cargo fmt --check 2>/dev/null || {
  echo "⚠️  cargo fmt found unformatted files. Run: cargo fmt"
  exit 1
}

# TOML formatting check (taplo)
if command -v taplo >/dev/null 2>&1; then
  taplo fmt --option reorder_keys=true --check 2>/dev/null || {
    echo "⚠️  taplo found unformatted TOML files. Run: taplo fmt"
    exit 1
  }
fi

# Cargo check with warnings-as-errors (matches CI)
RUSTFLAGS="-D warnings" cargo check --all-targets 2>/dev/null || {
  echo "⚠️  cargo check found errors."
  exit 1
}
