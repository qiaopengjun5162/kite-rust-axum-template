#!/bin/sh
set -e
export PATH="node_modules/.bin:$PATH"

# Rust formatting
cargo fmt --check 2>/dev/null || {
  echo "⚠️  cargo fmt found unformatted files. Run: cargo fmt"
  exit 1
}

# Cargo check (quick)
cargo check --all 2>/dev/null || exit 1

# Prevent whitespace issues
git diff --check 2>/dev/null || true
